# Production environment variables for Vercel deployment
# These are injected at build time by Vite
# VITE_API_URL points to the deployed Render backend
# Update this URL after deploying backend to Render
VITE_API_URL=https://easyhealth-api.onrender.com/api
VITE_AI_SERVICE_URL=https://easyhealth-ai.onrender.com/ai
