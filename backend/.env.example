PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://easyhealth:password@localhost:5432/easyhealth
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
# Use a 64-character hex key or a Base64-encoded 32-byte key. Never commit a real key.
ENCRYPTION_KEY=replace-with-a-random-32-byte-key
